# =============================================================================
# Football Arena — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Local run:   postgres://arena:arena@localhost:5432/arena
# Docker run:  postgres://arena:arena@postgres:5432/arena
DATABASE_URL=postgres://arena:arena@localhost:5432/arena
DB_CONN_MAX_AGE=60
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena

# --- Redis / Celery / Channels ----------------------------------------------
# Docker run: redis://redis:6379/0
# REDIS_ENABLED=False lets `config.settings.dev` run with no Redis server at all
# (in-memory cache, channel layer and eager Celery). Never do this in production.
REDIS_ENABLED=True
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Leave empty to reuse SECRET_KEY
JWT_SIGNING_KEY=

# --- CORS / CSRF ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Platform ---------------------------------------------------------------
PLATFORM_NAME=Football Arena
PLATFORM_COMMISSION_PERCENT=10
DEFAULT_CURRENCY=UZS

# --- Booking rules ----------------------------------------------------------
BOOKING_MIN_DURATION_HOURS=1
BOOKING_MAX_DURATION_HOURS=6
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCEL_WINDOW_HOURS=3

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5
# Returns the OTP in the API response. DEV ONLY — forced off in production.
OTP_DEBUG_RETURN_CODE=True

# --- SMS provider (console | eskiz | playmobile) ----------------------------
# `console` prints the SMS to stdout — no credentials required for development.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=4546

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google

# --- Telegram Login Widget --------------------------------------------------
# Create a bot via @BotFather, then /setdomain to your frontend domain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# --- Yandex Maps ------------------------------------------------------------
# https://developer.tech.yandex.ru/services -> JavaScript API and Geocoder
YANDEX_MAPS_API_KEY=

# --- Media storage ----------------------------------------------------------
# Leave empty to store uploads on the local filesystem (MEDIA_ROOT).
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
MAX_UPLOAD_SIZE_MB=8

# --- Email ------------------------------------------------------------------
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Football Arena <noreply@arena.uz>

# --- Rate limits ------------------------------------------------------------
THROTTLE_OTP_REQUEST=5/hour
THROTTLE_OTP_VERIFY=10/hour
THROTTLE_LOGIN=10/hour
THROTTLE_BOOKING_CREATE=30/hour
THROTTLE_CHAT_MESSAGE=120/minute
THROTTLE_ANON=120/minute
THROTTLE_USER=1000/hour

# --- Seed data (python manage.py seed_data) ---------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!
SEED_OWNER_PASSWORD=Owner12345!

# --- Frontend (frontend/.env) ------------------------------------------------
# These are baked into the browser bundle — only put PUBLIC values here.
# The Yandex/Google/Telegram public keys are served at runtime by
# `GET /api/config/`, so they are read from the backend variables above.
# See `frontend/.env.example`.
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
