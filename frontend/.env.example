# =============================================================================
# Football Arena — frontend environment template
# Copy to `frontend/.env`. Everything here is baked into the browser bundle,
# so it must contain PUBLIC values only. Never put an API secret in this file.
# =============================================================================

# Base URL of the Django REST API. No trailing slash.
VITE_API_URL=http://localhost:8000/api

# Base URL of the Channels WebSocket endpoint. No trailing slash.
# Use wss:// in production.
VITE_WS_URL=ws://localhost:8000/ws

# NOTE: the Yandex Maps key, Google client id and Telegram bot username are NOT
# configured here. The frontend fetches them at runtime from `GET /api/config/`
# so that rotating a key does not require rebuilding the bundle.
